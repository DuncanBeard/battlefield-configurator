# Never use a VITE_ prefix for secrets. Generate a random secret before starting the API.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8080
DATABASE_PATH=data/configurator.sqlite
PORT=3000
TRUST_PROXY=false
# Explicit testing-only username/password accounts; rejected for non-localhost origins.
LOCAL_AUTH_ENABLED=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# For native Bun + Vite development, use BETTER_AUTH_URL=http://localhost:1420.
BF6_API_TARGET=http://127.0.0.1:3000
VITE_ENABLE_ACCOUNTS=true
